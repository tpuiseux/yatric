# Copy to .env and fill in. See the Configuration table in README.md.

# Sign-ups at /signup need this code; leave empty to close sign-ups.
SIGNUP_INVITE_CODE=

# The coach (chat, weekly reviews, plan creation).
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=medium
# COACH_PLAN_MODEL=claude-opus-5-5
# COACH_PLAN_EFFORT=high
# COACH_DAILY_LIMIT=40
# COACH_PLAN_DAILY_LIMIT=3
# COACH_TIMEZONE=Europe/Paris

# Garmin bridge (optional).
# GARMIN_BRIDGE_URL=http://172.17.0.1:8420
# GARMIN_BRIDGE_TOKEN=

# Behind a reverse proxy that sets X-Real-IP.
# ADDRESS_HEADER=X-Real-IP
