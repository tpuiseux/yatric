{
  "name": "yatric",
  "version": "0.1.0",
  "private": true,
  "description": "Endurance training plans with an AI coach, synced with Garmin.",
  "author": "Thomas Puiseux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpuiseux/yatric.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "deploy": "bash scripts/deploy.sh",
    "create-user": "tsx scripts/create-user.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "svelte-kit sync || echo ''; husky"
  },
  "lint-staged": {
    "*.{js,ts,json,md,html,css,svelte}": "prettier --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@garmin/fitsdk": "^21.178.0",
    "consola": "^3.2.3",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.43.12",
    "svelte-check": "^4.7.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
