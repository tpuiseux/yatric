# Copy to .env.deploy (not committed) for `npm run deploy`.

# ssh host of the server, and the folder there holding compose.yml.
DEPLOY_HOST=my-server
DEPLOY_DIR=~/yatric

# The app's container, and its database path inside the container.
DEPLOY_CONTAINER=yatric
DEPLOY_DB=/data/yatric.db

# Optional: the app's public URL, checked after deploying.
# DEPLOY_URL=https://your-domain.example

# Optional, for `npm run deploy -- --bridge`: where the Garmin bridge's
# files live on the server, and its systemd service.
# BRIDGE_DIR=~/garmin-bridge
# BRIDGE_SERVICE=garmin-bridge
